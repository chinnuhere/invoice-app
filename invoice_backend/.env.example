# =================================================================
# Backend Environment Configuration
# Copy this file to '.env' and fill in the actual values.
# =================================================================

# Database configuration
# The database host (default: localhost)
DB_HOST=localhost
# The database username (default: postgres)
DB_USER=postgres
# The database name (default: invoice_app)
DB_NAME=invoice_app
# The database port (default: 5432)
DB_PORT=5432
# The password for the database user (required)
DB_PASSWORD=your_postgresql_password_here

# Security configuration
# A secure, random secret key used to sign and verify JWT authentication tokens
JWT_SECRET=your_jwt_secret_here

# Server configuration (optional)
# The port the Express application server will listen on
PORT=8000
